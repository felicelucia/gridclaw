# ==========================================================================
# GridClaw — environment
# Copy this file to ".env" and paste your keys. NEVER commit your real .env.
# You can run with ZERO keys (offline demo). Add keys to go LIVE.
# Trinity cross-critique activates with 2+ reasoning models.
# ==========================================================================

# --- Reasoning models (the "Trinity") -------------------------------------
# At least ONE makes the swarm live; TWO+ unlock cross-critique + fusion.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: override default model names
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_MODEL=deepseek-chat

# --- Real web search (Source Finder cites real, dated sources) ------------
# Without this, Source Finder uses the country module's ground truth only.
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# --- Server ---------------------------------------------------------------
PORT=8099
